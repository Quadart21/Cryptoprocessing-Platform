# Скопируйте в examples/.env и заполните. Файл .env не коммитится.

TELEGRAM_BOT_TOKEN=
NOREN_API_BASE=https://noren.digital
NOREN_PUBLIC_KEY=
NOREN_SECRET_KEY=
NOREN_PROJECT_ID=

# Тот же секрет, что в кабинете → Integration → Webhook.
NOREN_WEBHOOK_SECRET=

# Локальный приёмник. Публичный HTTPS (ngrok / cloudflare tunnel) должен смотреть сюда.
NOREN_WEBHOOK_HOST=0.0.0.0
NOREN_WEBHOOK_PORT=8787
# Полный URL, который Noren сможет вызвать, например https://shop.example.com/webhooks/noren
NOREN_WEBHOOK_PUBLIC_URL=

# Если задать почту и пароль кабинета, бот сам сохранит webhook URL и секрет.
# NOREN_MERCHANT_EMAIL=
# NOREN_MERCHANT_PASSWORD=
# NOREN_MERCHANT_OTP=

NOREN_FIAT_CURRENCY=USD
NOREN_DEFAULT_AMOUNT=10
# Пустые значения: бот возьмёт USDT/TRC20 или первую сеть из GET /rates.
NOREN_CRYPTO_CURRENCY=
NOREN_NETWORK=
NOREN_POLL_INTERVAL=15

# Пусто — бот отвечает всем, кто ему пишет.
# TELEGRAM_ALLOWED_USER_IDS=123456789
